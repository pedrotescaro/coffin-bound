varying vec2 v_vTexcoord;varying vec4 v_vColour;vec3 gb(vec3 c){vec3 a=vec3(15.,56.,15.)/255.,b=vec3(48.,98.,48.)/255.,d=vec3(139.,172.,15.)/255.,e=vec3(155.,188.,15.)/255.;vec3 q=a;float n=dot(c-a,c-a);float x=dot(c-b,c-b);if(x<n){q=b;n=x;}x=dot(c-d,c-d);if(x<n){q=d;n=x;}x=dot(c-e,c-e);if(x<n)q=e;return q;}void main(){vec4 c=v_vColour*texture2D(gm_BaseTexture,v_vTexcoord);gl_FragColor=vec4(gb(c.rgb),step(.5,c.a));}